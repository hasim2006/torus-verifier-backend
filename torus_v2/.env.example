# Copy to .env and fill in values for local development.
# Never commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite — no extra service needed):
DATABASE_URL=sqlite+aiosqlite:///./torus_dev.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/torus

# ── Security ──────────────────────────────────────────────────────────────────
CHALLENGE_TTL_SECONDS=300
REPLAY_CACHE_TTL_SECONDS=360
MAX_CLOCK_SKEW_SECONDS=60

# ── Rate Limits ───────────────────────────────────────────────────────────────
CHALLENGE_RATE_LIMIT=10/minute
AUTH_RATE_LIMIT=5/minute

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Lock this down in production.
CORS_ORIGINS=["*"]
